{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node"]
  },
  "include": ["src"]
}
