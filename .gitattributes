# Generated contracts are compared byte-for-byte with the LF generator output.
# Keep Windows checkouts identical even when core.autocrlf is enabled.
Vivic_Kimi_Handoff_v0.6/contracts/*.schema.json text eol=lf

# Keep collaboration documents consistent across Windows and Unix checkouts.
*.md text eol=lf
.editorconfig text eol=lf
.github/CODEOWNERS text eol=lf

# Server maintenance scripts are executed directly by Bash.
*.sh text eol=lf

# Evaluation descriptions are updated by scripts on both Windows and macOS.
evals/decision/*.json text eol=lf
evals/decision/results/*.json text eol=lf
